[user]
	name = Rohin
	email = git@r0h.in
	signingkey = 8E2B506AB2AEE22F9A79DCBC8B49EDC34064CE43
[init]
	defaultBranch = main
[gpg]
	format = openpgp
	program = /opt/homebrew/bin/gpg
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
